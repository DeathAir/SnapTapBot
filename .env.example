APP_NAME=SnapTapBot
DEBUG=False

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=snaptapbot
# Для Docker используем @db, для локального запуска @localhost
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/snaptapbot

# API
API_KEY=your_api_key
# Для Docker http://api:8000, локально http://localhost:8000
BASE_URL=http://api:8000
VERIFY_PATH=/verify
STATIC_DIR=static

# Telegram Bot
BOT_TOKEN=your_bot_token
SUPERADMIN_ID=123456789